{
  "name": "google-shopping-for-shop",
  "version": "0.1.28",
  "tablePrefix": "gsf_",
  "description": "Puts your shop on Google Shopping. Serves a product feed for Google Merchant Center in which every variation is its own listing - its own price, photos, stock and link - grouped under its parent product, so a search for the exact size and colour someone wants finds the exact size and colour you sell. Give Google the feed address once and it keeps itself up to date; brand and barcode details can be set per product, and anything you would rather keep off Google can sit the feed out. It also serves a review feed, so the star ratings customers leave here can show on your Google listings, and can offer Google's own survey on the order confirmation page for a seller rating.",
  "requiresCoreVersion": "0.5.1679",
  "requiresModules": [
    {
      "name": "shop",
      "minVersion": "0.1.452"
    },
    {
      "name": "shop-variations",
      "minVersion": "0.1.172"
    }
  ],
  "requiredEnvVars": [
    {
      "name": "GOOGLE_SHOPPING_SERVICE_ACCOUNT_JSON",
      "required": false
    },
    {
      "name": "GOOGLE_ADS_CLIENT_ID",
      "required": false
    },
    {
      "name": "GOOGLE_ADS_CLIENT_SECRET",
      "required": false
    },
    {
      "name": "GOOGLE_ADS_REFRESH_TOKEN",
      "required": false
    },
    {
      "name": "GOOGLE_ADS_CUSTOMER_ID",
      "required": false
    },
    {
      "name": "GOOGLE_ADS_LOGIN_CUSTOMER_ID",
      "required": false
    },
    {
      "name": "GOOGLE_ADS_DEVELOPER_TOKEN",
      "required": false
    }
  ],
  "permissions": [],
  "navEntries": [],
  "cookieCategories": [
    {
      "key": "marketing",
      "label": "Marketing",
      "description": "Lets us see which adverts and Google listings led to an order, so we know what is worth paying for."
    }
  ],
  "cspOrigins": {
    "script": [
      "https://apis.google.com"
    ],
    "img": [
      "https://ssl.gstatic.com",
      "https://www.gstatic.com",
      "https://www.google.com"
    ],
    "frame": [
      "https://www.google.com",
      "https://apis.google.com"
    ]
  },
  "publicBasePath": "google-shopping",
  "settingsTabs": [
    {
      "id": "google-shopping-for-shop",
      "label": "Google Shopping",
      "permission": "shop.manage",
      "host": "shop.settings-sub-tabs",
      "import": "./components/SettingsTab",
      "component": "GoogleShoppingSettingsTab"
    }
  ],
  "emailTemplates": {
    "groupLabel": "Google Shopping",
    "import": "./lib/email-templates",
    "export": "googleShoppingEmailTemplates"
  },
  "extensionPoints": [
    {
      "point": "shop.product-editor-sections",
      "id": "google-shopping",
      "label": "Google Shopping",
      "order": 60,
      "permission": "shop.products",
      "import": "./components/admin/ProductGoogleShoppingSection",
      "component": "ProductGoogleShoppingSection"
    },
    {
      "point": "shop.products-tabs",
      "id": "google-shopping-workbench",
      "label": "Google Shopping",
      "order": 80,
      "permission": "shop.products",
      "import": "./components/ShoppingWorkbench",
      "component": "GoogleShoppingWorkbench"
    },
    {
      "point": "shop.product-merchant-facts",
      "id": "google-shopping",
      "import": "./lib/merchant-facts-provider",
      "component": "googleShoppingMerchantFacts"
    },
    {
      "point": "shop.order-paid",
      "id": "google-shopping-attribution",
      "import": "./lib/order-paid-observer",
      "component": "googleShoppingOrderPaid"
    },
    {
      "point": "shop.product-saved",
      "id": "google-shopping-live-updates",
      "import": "./lib/push/observer",
      "component": "googleShoppingProductSaved"
    },
    {
      "point": "shop.order-detail-panels",
      "id": "google-shopping-click",
      "label": "Came from Google",
      "order": 70,
      "permission": "shop.orders",
      "import": "./components/admin/OrderGoogleClickPanel",
      "component": "OrderGoogleClickPanel"
    }
  ],
  "puckBlocks": [
    {
      "type": "GoogleCustomerReviews",
      "import": "./components/CustomerReviewsBlock",
      "component": "googleCustomerReviewsBlockComponent",
      "rscImport": "./components/CustomerReviewsBlock.rsc",
      "rscComponent": "googleCustomerReviewsBlockRscComponent",
      "layoutTypes": [
        "shopConfirmation"
      ]
    }
  ],
  "autoPlaceBlocks": [
    {
      "type": "GoogleCustomerReviews",
      "layoutType": "shopConfirmation"
    }
  ],
  "teardown": [
    "gsf_settings",
    "gsf_product_data",
    "gsf_category_taxonomy",
    "gsf_title_templates",
    "gsf_item_match_status",
    "gsf_item_match_history",
    "gsf_title_template_batches",
    "gsf_title_template_batch_items",
    "gsf_change_log",
    "gsf_feed_rules",
    "gsf_item_issues",
    "gsf_feed_fetch_status",
    "gsf_promotion_windows",
    "gsf_performance_daily",
    "gsf_best_sellers",
    "gsf_click_events",
    "gsf_attributed_orders",
    "gsf_beacon_rate",
    "gsf_push_queue",
    "gsf_push_state",
    "gsf_push_run",
    "gsf_ads_performance_daily",
    "gsf_ads_conversion_uploads",
    "gsf_ads_run"
  ],
  "cronJobs": [
    {
      "path": "/api/m/google-shopping-for-shop/cron/match-status",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/m/google-shopping-for-shop/cron/push",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/m/google-shopping-for-shop/cron/ads",
      "schedule": "40 * * * *"
    }
  ]
}
